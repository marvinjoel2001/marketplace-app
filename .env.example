# URL pública del backend del marketplace (incluye /api/v1, sin barra final)
NEXT_PUBLIC_API_URL=https://marketplace-backend-production-a82f.up.railway.app/api/v1
# URL pública de este frontend (dominio de Vercel); se usa en los redirects de OAuth
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app

# Opcional: inicio de sesión con Google y TikTok. Sin estas variables los botones entran con una cuenta demo.
# URLs de retorno a registrar: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google y .../tiktok
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
