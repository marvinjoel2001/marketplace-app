# URL pública del backend del marketplace (incluye /api/v1, sin barra final)
NEXT_PUBLIC_API_URL=https://marketplace-backend-production-a82f.up.railway.app/api/v1
# URL pública de este frontend (dominio de Vercel); se usa en los redirects de OAuth
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app

# Opcional: inicio de sesión con Google y TikTok. Sin estas variables los botones entran con una cuenta demo.
# URLs de retorno a registrar: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google y .../tiktok
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Obligatorio en producción: firma la cookie de sesión de los clientes (cadena larga y aleatoria).
SESSION_SECRET=
# Misma clave que AUTH_INTERNAL_KEY del backend: solo este servidor puede pedir códigos o iniciar sesiones.
AUTH_INTERNAL_KEY=

# Opcional / Recomendado: Firebase Phone Auth (10.000 SMS gratuitos al mes sin costo de WhatsApp)
# Si no se definen, el sistema usa el modo de desarrollo o el servicio de WhatsApp configurado en el panel.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
